# Production environment — copy to .env and fill in values.
# Generate secret: openssl rand -base64 48

MB_JWT_SECRET=change-me-to-a-strong-random-value

# PostgreSQL connection (used by docker-compose.postgres.yaml)
POSTGRES_USER=mantis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mantisbase

# MantisBase database URL (postgresql backend)
MB_DB=postgresql
MB_DB_URL=dbname=mantisbase host=postgres user=mantis password=change-me

# Optional tuning
# MB_HOST=0.0.0.0
# MB_PORT=8080
# MB_DISABLE_FILE_UPLOADS=0
# MB_DISABLE_RATE_LIMIT=0
