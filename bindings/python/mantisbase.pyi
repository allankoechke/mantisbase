"""Type stubs for the mantisbase nanobind extension.

Installed beside the extension module. ``mantisbase.utils`` and
``mantisbase.middlewares`` are submodules created by the extension; type
checkers see them as attributes of this module.
"""

from __future__ import annotations

from collections.abc import Callable, Mapping, Sequence
from typing import Any, Literal, overload

DbType = Literal["sqlite3", "postgresql"]
BindValue = None | bool | int | float | str
Record = dict[str, Any]
RouteHandler = Callable[..., Any]
MiddlewareFn = Callable[["MbRequest", "MbResponse"], bool | None]

class MantisError(Exception):
    """Failure reported by the C++ layer.

    ``code`` is an HTTP-style status. ``description`` is the longer detail
    and may be empty. The exception message is ``args[0]``.
    """

    code: int
    description: str

class MbRequest:
    """Incoming HTTP request passed to a route handler."""

    @property
    def method(self) -> str: ...
    @property
    def path(self) -> str: ...
    @property
    def remote_addr(self) -> str: ...
    @property
    def remote_port(self) -> int: ...
    @property
    def local_addr(self) -> str: ...
    @property
    def local_port(self) -> int: ...
    def path_param(self, name: str) -> str: ...
    def has_path_params(self) -> bool: ...
    def has_path_param(self, name: str) -> bool: ...
    def query_param(self, name: str) -> str: ...
    def has_query_param(self, name: str) -> bool: ...
    def header(self, name: str, default: str = "") -> str: ...
    def has_header(self, name: str) -> bool: ...
    def hasHeader(self, name: str) -> bool: ...
    def cookie(self, name: str) -> str: ...
    def bearer_token(self) -> str: ...
    def auth_token(self) -> str: ...
    def body(self) -> str: ...
    def json(self) -> Any: ...
    def is_multipart(self) -> bool: ...
    def form_data(self) -> list[dict[str, Any]]: ...
    def file_metadata(self) -> Any: ...
    def parse_form(self, entity: Entity) -> None:
        """Map a multipart body onto an entity. No-op for JSON bodies."""
    def write_files(self, entity: str) -> None: ...
    def undo_files(self, entity: str) -> None: ...
    def has_key(self, key: str) -> bool: ...
    def get(self, key: str) -> Any: ...
    def get_or(self, key: str, default: Any) -> Any: ...
    def set(self, key: str, value: Any) -> None: ...
    def is_guest(self) -> bool: ...
    def is_admin(self) -> bool: ...
    def is_user(self) -> bool: ...

class MbResponse:
    """Outgoing HTTP response passed to a route handler."""

    @property
    def status(self) -> int: ...
    @status.setter
    def status(self, value: int) -> None: ...
    @property
    def body(self) -> str: ...
    @body.setter
    def body(self, value: str) -> None: ...
    @property
    def location(self) -> str: ...
    def json(self, status: int, data: Any) -> None: ...
    def html(self, status: int, body: str) -> None: ...
    def text(self, status: int, body: str) -> None: ...
    def send(self, status: int, data: str = "", content_type: str = "text/plain") -> None: ...
    def empty(self, status: int = 204) -> None: ...
    def redirect(self, url: str, status: int = 302) -> None: ...
    def set_header(self, name: str, value: str) -> None: ...
    def has_header(self, name: str) -> bool: ...
    def header(self, name: str, default: str = "") -> str: ...
    def set_content(self, body: str, content_type: str) -> None: ...
    def set_file(self, path: str, content_type: str | None = None) -> None: ...
    def set_auth_cookie(self, token: str, max_age: int) -> None: ...
    def clear_auth_cookie(self) -> None: ...

class Middleware:
    """C++ middleware for a route's ``middlewares`` argument.

    Calling it as ``mw(req, res)`` returns ``True`` when the chain should continue.
    """

    def __call__(self, req: MbRequest, res: MbResponse) -> bool: ...

MiddlewareLike = Middleware | MiddlewareFn
Middlewares = MiddlewareLike | Sequence[MiddlewareLike] | None

class Sse:
    """Server-Sent Events and WebSocket fan-out."""

    def broadcast(self, event: Any) -> None: ...
    def session_count(self) -> int: ...
    def remove_session(self, client_id: str) -> None: ...
    def is_running(self) -> bool: ...
    def ws_connection_count(self) -> int: ...

class MbRouter:
    """HTTP route table for one MantisBase app."""

    @property
    def is_running(self) -> bool: ...
    @property
    def sse(self) -> Sse: ...
    @overload
    def get(self, path: str, handler: RouteHandler, middlewares: Middlewares = ...) -> RouteHandler: ...
    @overload
    def get(
        self,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    @overload
    def post(self, path: str, handler: RouteHandler, middlewares: Middlewares = ...) -> RouteHandler: ...
    @overload
    def post(
        self,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    @overload
    def put(self, path: str, handler: RouteHandler, middlewares: Middlewares = ...) -> RouteHandler: ...
    @overload
    def put(
        self,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    @overload
    def patch(self, path: str, handler: RouteHandler, middlewares: Middlewares = ...) -> RouteHandler: ...
    @overload
    def patch(
        self,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    @overload
    def delete(self, path: str, handler: RouteHandler, middlewares: Middlewares = ...) -> RouteHandler: ...
    @overload
    def delete(
        self,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    @overload
    def add_route(
        self,
        method: str,
        path: str,
        handler: RouteHandler,
        middlewares: Middlewares = ...,
    ) -> RouteHandler: ...
    @overload
    def add_route(
        self,
        method: str,
        path: str,
        handler: None = None,
        middlewares: Middlewares = ...,
    ) -> Callable[[RouteHandler], RouteHandler]: ...
    def redirect(
        self,
        source: str,
        destination: str,
        status: int = 302,
        methods: Sequence[str] | None = None,
    ) -> None:
        """Redirect a path. ``methods`` defaults to ``['GET']``; pass ``[]`` to allow every method."""
    def broadcast(self, event: Any) -> None:
        """Push a change event to SSE and WebSocket subscribers."""

class Transaction:
    """Database transaction leased from the connection pool."""

    def query(self, sql: str, *params: Mapping[str, BindValue]) -> list[Record]: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def __enter__(self) -> Transaction: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        traceback: Any,
    ) -> bool: ...

