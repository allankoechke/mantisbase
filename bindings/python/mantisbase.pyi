class App:
    """Embedded MantisBase server.

    Constructor keywords are snake_case. Any other keyword is ignored.
    Pass ``dev=True`` for local use. Otherwise pass ``secret_key`` (or export
    ``MB_JWT_SECRET``) before ``start()``.
    """

    def __init__(
        self,
        *,
        port: int = ...,
        host: str = ...,
        data_dir: str = ...,
        db_type: DbType = ...,
        db_url: str = ...,
        public_dir: str = ...,
        scripts_dir: str = ...,
        templates_dir: str = ...,
        migrations_dir: str = ...,
        pool_size: int = ...,
        dev: bool = ...,
        skip_admin_setup: bool = ...,
        secret_key: str = ...,
    ) -> None: ...
    def start(self, blocking: bool = True) -> None: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def quit(self, code: int = 0, reason: str = "Something went wrong!") -> None:
        """Stop the server and terminate the process with ``std::exit``."""
    def open_admin_dashboard(self) -> None: ...
    def snowflake_id(self) -> str: ...
    @property
    def host(self) -> str: ...
    @host.setter
    def host(self, value: str) -> None: ...
    @property
    def port(self) -> int: ...
    @port.setter
    def port(self, value: int) -> None: ...
    @property
    def pool_size(self) -> int: ...
    @pool_size.setter
    def pool_size(self, value: int) -> None: ...
    @property
    def public_dir(self) -> str: ...
    @public_dir.setter
    def public_dir(self, value: str) -> None: ...
    @property
    def data_dir(self) -> str: ...
    @data_dir.setter
    def data_dir(self, value: str) -> None: ...
    @property
    def scripts_dir(self) -> str: ...
    @scripts_dir.setter
    def scripts_dir(self, value: str) -> None: ...
    @property
    def templates_dir(self) -> str: ...
    @templates_dir.setter
    def templates_dir(self, value: str) -> None: ...
    @property
    def migrations_dir(self) -> str: ...
    @migrations_dir.setter
    def migrations_dir(self, value: str) -> None: ...
    @property
    def skip_admin_setup(self) -> bool: ...
    @skip_admin_setup.setter
    def skip_admin_setup(self, value: bool) -> None: ...
    @property
    def db_type(self) -> DbType: ...
    @property
    def dev_mode(self) -> bool: ...
    @property
    def scripting_disabled(self) -> bool: ...
    @property
    def secret_key(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def uptime_seconds(self) -> int: ...
    @property
    def router(self) -> MbRouter: ...
    @property
    def db(self) -> MbDatabase: ...
    @property
    def settings(self) -> Settings: ...
    @property
    def auth(self) -> MbAuth: ...
    @property
    def files(self) -> Files: ...
    @property
    def logs(self) -> Logs: ...
    @property
    def rt(self) -> Realtime: ...
    @property
    def mailer(self) -> Mailer: ...
    def entity(self, name: str) -> Entity: ...
    def has_entity(self, name: str) -> bool: ...
    def create_schema(self, schema: Mapping[str, Any]) -> Record: ...
    def list_schemas(self, opts: Mapping[str, Any] | None = None) -> list[Record]: ...
    def get_schema(self, table_id: str) -> Record: ...
    def update_schema(self, table_id: str, schema: Mapping[str, Any]) -> Record: ...
    def drop_schema(self, table_id: str) -> None: ...
    def table_exists(self, name: str) -> bool: ...
    def validate_schema(self, schema: Mapping[str, Any]) -> str | None: ...

